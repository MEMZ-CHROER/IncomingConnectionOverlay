<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- 动画总时长（秒） -->
    <add key="Duration" value="6" />
    <!-- 淡入/淡出时长（秒） -->
    <add key="Fade" value="0.2" />
    <!-- 黑条最大高度（px，按 ScaleBase 缩放） -->
    <add key="BarHeightMax" value="120" />
    <!-- 中央排版区宽（px） -->
    <add key="CenterWidth" value="700" />
    <!-- 斜纹高度（px） -->
    <add key="StripeHeightMax" value="24" />
    <!-- 斜纹滚动速度（贴图宽/秒） -->
    <add key="StripeSpeed" value="1" />
    <!-- 开场/收尾闪烁周期（秒） -->
    <add key="BlinkPeriod" value="0.1" />
    <!-- 闪烁占空比（0~1） -->
    <add key="BlinkOnRatio" value="0.5" />
    <!-- tint 主色（R,G,B，0~255） -->
    <add key="Tint" value="255,0,0" />
    <!-- 分辨率缩放基准（屏幕高度 px，元素尺寸 = 常量 × 屏幕高/基准） -->
    <add key="ScaleBase" value="1080" />
    <!-- 标题文字 -->
    <add key="TitleText" value="INCOMING CONNECTION" />
    <!-- 详情文字（&#10; 为换行） -->
    <add key="DetailText" value="External unsyndicated UDP traffic on port 22&#10;Logging all activity to ~/log" />
    <!-- 检测到扫描时是否把真实源 IP 注入详情文字（true/false） -->
    <add key="SyncIpToDetail" value="true" />
  </appSettings>
</configuration>
